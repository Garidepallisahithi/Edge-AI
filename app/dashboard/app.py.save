"""
Phase 5 Edge-AI Dashboard
Dashboard for visualizing calibration, explainability, and uncertainty metrics."""

import json
from pathlib import Path
import pandas as pd


# Initialize Flask ap

# Configuration
REPORTS_DIR = Path(__f
def load_metrics():
    """Load metrics from phase 5 output files."""
    metrics = {}
    
    # Calibration metrics
    if (REPORTS_DIR / "calibration.json").exists():
        with open(REPORTS_DIR / "calibration.json") as f:
            metrics["calibration"] = json.load(f)
    
    # Classification metrics
    if (REPORTS_DIR / "metrics.json").exists():
        with open(REPORTS_DIR / "metrics.json") as f:
            metrics["classification"] = json.load(f)
    
    # Uncertainty metrics
    if (REPORTS_DIR / "uncertainty.json").exists():
        with open(REPORTS_DIR / "uncertainty.json") as f:
            metrics["uncertainty"] = json.load(f)
    
    return metrics


def load_explanations():
    """Load explanation data."""
    explanations = {}
    
    # Global importance
    if (REPORTS_DIR / "explanations" / "global_feature_importance.csv").exists():
        df_global = pd.read_csv(
            REPORTS_DIR / "explanations" / "global_feature_importance.csv"
        )
        explanations["global"] = df_global.to_dict(orient="records")
    
    # Local explanations
    if (REPORTS_DIR / "explanations" / "local_explanations.csv").exists():
        df_local = pd.read_csv(
            REPORTS_DIR / "explanations" / "local_explanations.csv"
        )
        explanations["local"] = df_local.to_dict(orient="records")
    
    return explanations


@app.route("/")
def index():
    """Render main dashboard page."""
    return render_template("index.html")


@app.route("/api/metrics")
def api_metrics():
    """API endpoint for metrics."""
    return jsonify(load_metrics())


@app.route("/api/explanations")
def api_explanations():
    """API endpoint for explanations."""
    return jsonify(load_explanations())


@app.route("/api/predictions")
def api_predictions():
    """API endpoint for predictions."""
    predictions = {}
    
    # Internal test predictions
    if (REPORTS_DIR / "internal_test_predictions_calibrated.csv").exists():
        df_test = pd.read_csv(
            REPORTS_DIR / "internal_test_predictions_calibrated.csv"
        )
        predictions["internal_test"] = {
            "total": len(df_test),
            "anomalies": int((df_test["prediction"] == 1).sum()),
            "normals": int((df_test["prediction"] == 0).sum()),
        }
    
    # Validation predictions
    if (REPORTS_DIR / "validation_predictions_calibrated.csv").exists():
        df_val = pd.read_csv(
            REPORTS_DIR / "validation_predictions_calibrated.csv"
        )
        predictions["validation"] = {
            "total": len(df_val),
            "anomalies": int((df_val["prediction"] == 1).sum()),
            "normals": int((df_val["prediction"] == 0).sum()),
        }
    
    return jsonify(predictions)


if __name__ == "__main__":
    app.run(debug=True, port=5000)
